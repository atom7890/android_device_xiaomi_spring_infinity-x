cc_library_static {
    name: "libpowermode-ext-spring",
    defaults: [
        "android.hardware.power-ndk_shared",
    ],
    vendor: true,
    srcs: [
        "power-mode.cpp",
    ],
    shared_libs: [
        "libbase",
    ],
}

cc_library_static {
    name: "libpowerfeature-ext-spring",
    vendor: true,
    srcs: ["power-feature.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.aospa.power-V1-ndk",
    ],
}
