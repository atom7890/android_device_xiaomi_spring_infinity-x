    name: "perfservice",
    owner: "qcom",
    target: {
        android_arm64: {
            srcs: [
                "proprietary/system_ext/bin/perfservice",
            ],
            shared_libs: [
                "liblog",
                "libutils",
                "libbinder",
                "libavservices_minijail",
                "libcutils",
                "libbase",
                "libbinder_ndk",
                "android.hardware.thermal@1.0",
                "android.hardware.thermal@2.0",
                "libhidlmemory",
                "libhidlbase",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
