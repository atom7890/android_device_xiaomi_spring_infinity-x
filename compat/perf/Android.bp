// Device-local system performance integration.
// HIDL perf@2.x interfaces come from PenguinOS source in the root namespace.
// Blob paths resolve through the proprietary symlink to the manifest checkout.

dex_import {
    name: "QPerformance",
    owner: "qcom",
    jars: [
        "proprietary/system/framework/QPerformance.jar",
    ],
}

dex_import {
    name: "QXPerformance",
    owner: "qcom",
    jars: [
        "proprietary/system/framework/QXPerformance.jar",
    ],
}

dex_import {
    name: "UxPerformance",
    owner: "qcom",
    jars: [
        "proprietary/system/framework/UxPerformance.jar",
    ],
}

cc_prebuilt_library_shared {
    name: "libqti_performance",
    owner: "qcom",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "proprietary/system_ext/lib/libqti_performance.so",
            ],
            shared_libs: [
                "libnativehelper",
                "libcutils",
                "liblog",
                "libutils",
                "libbase",
                "vendor.qti.hardware.iop@2.0",
                "libhidlbase",
                "libqti-perfd-client_system",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
        android_arm64: {
            srcs: [
                "proprietary/system_ext/lib64/libqti_performance.so",
            ],
            shared_libs: [
                "libnativehelper",
                "libcutils",
                "liblog",
                "libutils",
                "libbase",
                "vendor.qti.hardware.iop@2.0",
                "libhidlbase",
                "libqti-perfd-client_system",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "both",
    prefer: true,
    system_ext_specific: true,
}

